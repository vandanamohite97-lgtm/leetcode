class Solution {
    public int pairSum(ListNode h) {
        ListNode s = h, f = h, p = null;

        while (f != null) {
            s = s.next;
            f = f.next.next;
        }

        while (s != null) {
            ListNode n = s.next;
            s.next = p;
            p = s;
            s = n;
        }

        int max = 0;
        while (p != null) {
            max = Math.max(max, h.val + p.val);
            h = h.next;
            p = p.next;
        }

        return max;
    }
}
